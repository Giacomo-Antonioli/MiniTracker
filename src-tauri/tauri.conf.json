{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MiniTracker",
  "version": "../package.json",
  "identifier": "io.github.giacomoantonioli.minitracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MiniTracker",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Utility",
    "shortDescription": "Miniature backlog and army tracker",
    "publisher": "Giacomo Antonioli",
    "copyright": "PolyForm Noncommercial 1.0.0",
    "homepage": "https://github.com/Giacomo-Antonioli/MiniTracker"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QTIzOUQzQUEyOTAyRTAKUldUZ0FpbXEwem1pU0xuakRmU3l3STdCSlVDYmRzL0dNQ3VncitTRDNqSU1uQVRSSTdSWmVidjIK",
      "endpoints": [
        "https://github.com/Giacomo-Antonioli/MiniTracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

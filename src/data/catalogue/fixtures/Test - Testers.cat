<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="cat-testers" name="Test - Testers" gameSystemId="sys-test" revision="7" type="catalogue">
  <catalogueLinks>
    <catalogueLink type="catalogue" name="Test - Shared Library" id="cl1" targetId="cat-lib" importRootEntries="true"/>
  </catalogueLinks>
  <rules>
    <rule id="r-doctrine" name="Testers Doctrine" hidden="false">
      <description>Testers units re-roll hit rolls of 1.</description>
    </rule>
  </rules>
  <entryLinks>
    <entryLink import="true" name="Big Walker" hidden="false" type="selectionEntry" id="el10" targetId="u-walker"/>
    <entryLink import="true" name="Secret Thing" hidden="true" type="selectionEntry" id="el11" targetId="u-secret"/>
    <entryLink import="true" name="Detachment" hidden="false" type="selectionEntryGroup" id="el-det" targetId="g-det"/>
  </entryLinks>
  <sharedSelectionEntries>
    <selectionEntry type="model" import="true" name="Big Walker" hidden="false" id="u-walker">
      <categoryLinks>
        <categoryLink targetId="c-veh" id="l4" primary="true" name="Vehicle"/>
        <categoryLink targetId="c-fac" id="l5" primary="false" name="Faction: Testers"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="pts-id" value="150"/>
      </costs>
      <constraints>
        <constraint type="max" value="3" field="selections" scope="force" shared="true" id="lim-w"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="lim-w-parent"/>
      </constraints>
      <modifiers>
        <modifier type="set" value="2" field="lim-w">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="roster" childId="bs-inc" shared="true"/>
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Secret Thing" hidden="false" id="u-secret">
      <costs><cost name="pts" typeId="pts-id" value="1"/></costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rifle" hidden="false" id="w-rifle">
      <profiles>
        <profile name="Rifle" typeId="t-rw" typeName="Ranged Weapons" hidden="false" id="pw1">
          <characteristics>
            <characteristic name="Range" typeId="t-r">24"</characteristic>
            <characteristic name="Keywords" typeId="t-kw">Assault, Sustained Hits 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
  </sharedSelectionEntries>
  <sharedSelectionEntryGroups>
    <selectionEntryGroup name="Detachment" hidden="false" id="g-det">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="det-min"/>
        <constraint type="max" value="-1" field="selections" scope="parent" shared="true" id="det-max"/>
      </constraints>
      <modifiers>
        <modifier type="set" value="1" field="det-max">
          <conditions>
            <condition type="atLeast" value="1" field="selections" scope="force" childId="bs-inc" shared="true"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Line Doctrine" hidden="false" id="det-line">
          <costs>
            <cost name="pts" typeId="pts-id" value="0"/>
            <cost name="Detachment Points" typeId="dp-id" value="1"/>
          </costs>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Heavy Doctrine" hidden="false" id="det-heavy">
          <costs>
            <cost name="pts" typeId="pts-id" value="0"/>
            <cost name="Detachment Points" typeId="dp-id" value="3"/>
          </costs>
          <categoryLinks>
            <categoryLink targetId="c-3dp" id="l-3dp" primary="false" name="3DP Detachment"/>
          </categoryLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Boarding Doctrine" hidden="false" id="det-board">
          <costs>
            <cost name="pts" typeId="pts-id" value="0"/>
            <cost name="Detachment Points" typeId="dp-id" value="1"/>
          </costs>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="notInstanceOf" value="1" field="selections" scope="force" childId="f-board" shared="true"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Enhancements" hidden="false" id="g-enh">
      <selectionEntryGroups>
        <selectionEntryGroup name="Line Doctrine Enhancements" hidden="false" id="g-enh-line">
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="det-line" shared="true"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Lucky Charm" hidden="false" id="enh-charm">
              <costs>
                <cost name="pts" typeId="pts-id" value="15"/>
                <cost name="Enhancements" typeId="en-id" value="1"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Big Banner" hidden="false" id="enh-banner">
          <costs>
            <cost name="pts" typeId="pts-id" value="20"/>
            <cost name="Enhancements" typeId="en-id" value="1"/>
          </costs>
          <modifiers>
            <modifier type="set" value="true" field="hidden">
              <conditions>
                <condition type="lessThan" value="1" field="selections" scope="roster" childId="det-heavy" shared="true"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>

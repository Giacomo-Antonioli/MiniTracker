<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="cat-sub" name="Test - Testers - Sub Testers" gameSystemId="sys-test" revision="1" type="catalogue">
  <catalogueLinks>
    <catalogueLink type="catalogue" name="Test - Testers" id="cl2" targetId="cat-testers" importRootEntries="true"/>
  </catalogueLinks>
  <categoryEntries>
    <categoryEntry id="c-oldhero" name="Hero of Old" hidden="false">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="lim-h"/>
      </constraints>
    </categoryEntry>
  </categoryEntries>
  <selectionEntries>
    <selectionEntry type="model" import="true" name="Old Hero [Legends]" hidden="false" id="u-hero">
      <categoryLinks>
        <categoryLink targetId="c-char" id="l6" primary="true" name="Character"/>
        <categoryLink targetId="c-oldhero" id="l7" primary="false" name="Hero of Old"/>
      </categoryLinks>
      <infoLinks>
        <infoLink name="Old Hero" id="il1" hidden="false" type="profile" targetId="sp-hero"/>
      </infoLinks>
      <costs><cost name="pts" typeId="pts-id" value="95"/></costs>
      <modifiers>
        <modifier type="set" value="0" field="pts-id">
          <conditions>
            <condition type="equalTo" value="1" field="selections" scope="roster" childId="x" id="c9"/>
          </conditions>
        </modifier>
      </modifiers>
    </selectionEntry>
  </selectionEntries>
  <sharedProfiles>
    <profile name="Old Hero" typeId="t-unit" typeName="Unit" hidden="false" id="sp-hero">
      <characteristics>
        <characteristic name="M" typeId="c-m">6&quot;</characteristic>
        <characteristic name="W" typeId="c-w">5</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
</catalogue>

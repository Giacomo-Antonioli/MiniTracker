{
  "name": "minitracker",
  "private": true,
  "version": "0.27.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:bsdata": "vitest run --config vitest.live.config.ts",
    "schemes:scrape": "node --experimental-strip-types --no-warnings tools/schemes/scrape.mts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "spearhead:build": "node --experimental-strip-types --no-warnings tools/spearhead/build.mts",
    "paints:seed": "node --experimental-strip-types --no-warnings tools/paints/build-seed.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.7",
    "driver.js": "^1.10.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "i18next": "^27.0.1",
    "jsqr": "^1.4.0",
    "peerjs": "1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^31.0.0",
    "node-html-parser": "^9.0.6",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
